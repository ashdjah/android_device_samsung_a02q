on boot
    setprop ro.boot.vbmeta.avb_version 1.1
    setprop ro.boot.avb_version 1.1
    # Chipone ICNL9911C (hwid 991110) touch firmware - force load via CTS sysfs.
    # Stock/vendor file is present but driver often fails to load at boot (fwid 0000).
    start touchfw
    # Safety net: reboot to system if nothing happens for 45 seconds
    start autoreboot
    # dwc3'u device moduna zorla (yoksa adb hic gorunmez)
    start usbperiph
    # TWRP acik kaldigi surece USB'yi ayakta tut
    start usbkeep
    # Dokunmatik olu cihaz: swipe/lock varsayilanlarini kapat
    start twrpdefaults

# dwc3'u "peripheral" moduna zorlayan kisa servis.
# Ragekill agacindaki blok:
#   write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
# bizim agacta yoktu; sys.usb.controller set ediliyor ama dwc3 host modunda
# kaldigi icin gadget hicbir zaman enumerate olmuyordu.
service usbperiph /system/bin/sh /system/bin/usb-peripheral.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

# TWRP acik oldugu surece USB'yi ayakta tutar: tum dwc3/ssusb
# kontrolculerini device modunda, sys.usb.config'de adb'yi ve adbd'yi
# surekli guncel tutar. Kablo ne zaman takilirsa takilsin Termux veya PC
# erisebilir. oneshot DEGIL: betik cikarsa init yeniden baslatir.
service usbkeep /system/bin/sh /system/bin/usb-keepalive.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    disabled

service twrpdefaults /system/bin/sh /system/bin/twrp-defaults.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

# Chipone ICNL9911C touch firmware force-load. Fixes fwid 0000 / INVALID case
# where stock chipone-tddi.bin is present but CTS driver did not load it at boot.
service touchfw /system/bin/sh /system/bin/touch-fw.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    start usbperiph
    start usbkeep

# Otomatik yeniden baslatma guvenlik agi.
# TWRP acildiktan 45 saniye sonra hicbir girdi (dokunmatik / tus / fare)
# gelmezse BCB temizlenip cihaz sisteme yeniden baslatilir. Dokunmatik
# calismadiginda cihazin TWRP'de kilitli kalmasini onler.
# Iptal: /tmp/no-autoreboot veya /cache/.no-autoreboot dosyasi.
# Ust uste boot basarisizsa sayac tutulur; esikten sonra otomatik reboot durur.
service autoreboot /system/bin/sh /system/bin/autoreboot.sh
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    oneshot
    disabled

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    export ANDROID_ROOT /system_root
