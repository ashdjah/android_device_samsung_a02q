# mount point   fstype          device                  device2                flags
#
# TWRP fstab v1 format: <mount point> <fstype> <block device> [<device2>] [flags=...]
# The four logical lines below were copied from recovery.fstab, which is an
# AOSP v2 fstab (<src> <mnt_point> <type> ...). TWRP reads a line starting with
# '/' as v1, so the old "system /system ext4 ..." form produced an empty block
# device and "Failed to mount '/system' (Block device required)".
# Dynamic partitions must point at /dev/block/mapper/<name> and carry the
# "logical" flag inside flags=..., not as a bare token.

# Logical partitions (dynamic / super)
/system         ext4            /dev/block/mapper/system                       flags=display="System";logical;backup=1
/vendor         ext4            /dev/block/mapper/vendor                       flags=display="Vendor";logical;backup=1
/product        ext4            /dev/block/mapper/product                      flags=display="Product";logical;backup=1
/odm            ext4            /dev/block/mapper/odm                          flags=display="Odm";logical;backup=1

# Logical partition images - valid GUI wipe/flash targets, backed by the same mapper nodes.
/system_image   emmc            /dev/block/mapper/system                       flags=backup=1;display="System Image";flashimg=1;wipeingui
/vendor_image   emmc            /dev/block/mapper/vendor                       flags=backup=1;display="Vendor Image";flashimg=1;wipeingui
/product_image  emmc            /dev/block/mapper/product                      flags=backup=1;display="Product Image";flashimg=1;wipeingui
/odm_image      emmc            /dev/block/mapper/odm                          flags=backup=1;display="Odm Image";flashimg=1;wipeingui

# Physical partitions
/metadata       ext4            /dev/block/bootdevice/by-name/metadata         flags=backup=1;display="Metadata"
/boot           emmc            /dev/block/bootdevice/by-name/boot             flags=backup=1;display="Boot";flashimg=1
/recovery       emmc            /dev/block/bootdevice/by-name/recovery         flags=backup=1;display="Recovery";flashimg=1
/data           f2fs            /dev/block/bootdevice/by-name/userdata
/cache          ext4            /dev/block/bootdevice/by-name/cache            flags=backup=1;display="Cache"
/efs            ext4            /dev/block/bootdevice/by-name/sec_efs          flags=backup=1;display="EFS"
/firmware       emmc            /dev/block/bootdevice/by-name/apnhlos          flags=backup=1;display="Firmware"
/modem          emmc            /dev/block/bootdevice/by-name/modem            flags=backup=1;display="Modem"
/dsp            emmc            /dev/block/bootdevice/by-name/dsp
/misc           emmc            /dev/block/bootdevice/by-name/misc
/keydata        ext4            /dev/block/bootdevice/by-name/keydata
/keyrefuge      ext4            /dev/block/bootdevice/by-name/keyrefuge
/dtbo           emmc            /dev/block/bootdevice/by-name/dtbo             flags=backup=1;display="Dtbo"
/optics_image   emmc            /dev/block/bootdevice/by-name/optics           flags=backup=1;flashimg;display="Optics Image"
/prism_image    emmc            /dev/block/bootdevice/by-name/prism            flags=backup=1;flashimg;display="Prism Image"

# Removable storage
/external_sd    vfat            /dev/block/mmcblk1p1    /dev/block/mmcblk1     flags=storage;wipeingui;removable
/usb-otg        auto            /dev/block/sda1 /dev/block/sda                 flags=display="USB-OTG";storage;wipeingui;removable
